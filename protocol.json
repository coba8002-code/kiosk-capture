 "measure_items": [
  {
   "id": "1.c",
   "criterion": "모든 작동부의 최소경계상자(MBR: Minimum Bounding Box, 이하 '경계상자')는 각 변의 길이가 12mm 이상이고 표면적이 144mm² 이상이어야 한다. 이때 경계상자는 무인정보단말기 축에 정렬된 상태의 것을 의미한다.",
   "instrument": ""
  },
  {
   "id": "1.d",
   "criterion": "모든 작동부는 2.26 kgF(22.2 N) 이하의 힘으로 누르거나, 잡아당기거나, 밀어서 조작할 수 있어야 한다.",
   "instrument": "푸시풀 게이지 (0.1N 분해능)"
  },
  {
   "id": "1.i",
   "criterion": "배출구는 영수증, 티켓, 인쇄물 등의 배출물을 쉽게 받을 수 있고, 유실되지 않도록 설계되어야 한다. 배출물이 한 장인 경우에는 배출물을 잡을 수 있도록 최소 20mm 이상 배출하고 배출물이 유실되지 않도록 고정하여야 하며, 배출물이 여러 장인 경우에는 배출물이 튕겨 나가지 않고 담길 수 있도록 충분한 크기와 깊이를 갖춘 받침대로 배출되어야 한다.",
   "instrument": "자·푸시풀 게이지"
  },
  {
   "id": "3.g",
   "criterion": "모든 필수적인 문자는 문자 높이가 7.25mm 이상이 되도록 표시되어야 한다.",
   "instrument": ""
  },
  {
   "id": "5.c",
   "criterion": "무인정보단말기의 스피커는 사용자가 직접 음량을 65dBA 이상으로 조절하거나 음소거할 수 있어야 하고, 사용 후에는 자동으로 65dBA 미만으로 초기화되어야 한다.",
   "instrument": "적분형 소음계 (A특성, FAST) — 측정 조건은 measurement-sop.yaml 참조"
  },
  {
   "id": "9.a",
   "criterion": "모든 작동부는 바닥으로부터 400mm ~ 1,220mm 사이에 있어야 한다.",
   "instrument": "줄자 / 레이저 거리계"
  },
  {
